# Security headers for blurxy.net (Cloudflare Workers Static Assets).
#
# Content-Security-Policy-Report-Only is intentional: do NOT switch to an
# enforced Content-Security-Policy until Cloudflare-injected scripts (such as
# Web Analytics or email obfuscation, if enabled at the zone level) have been
# monitored in report-only mode to ensure no legitimate scripts are blocked.
# All site fonts — including /v1/ — are self-hosted under /assets/fonts/.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
